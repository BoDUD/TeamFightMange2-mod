{
  "en": {
    "description": {
      "lol_shen": {
        "name": "Shen",
        "attack": "Ninja Blade: Shen makes a steady melee strike for 100% Attack physical damage.",
        "skill": "Q — Twilight Slash: Sends the spirit blade through enemies for 40 + 60% Ability Power magic damage and slows them by 25% for 1.5 seconds. Hitting an enemy grants Shen a 120 shield for 2 seconds.",
        "skill2": "W — Spirit's Refuge: Creates a defensive field around Shen. Allies gain a 150 + 40% Ability Power shield for 2.5 seconds, while enemies lose 30% Attack Speed for 2 seconds.",
        "ult": "R — Stand United: Shields a distant allied champion for 900 + 80% Ability Power for 3 seconds. After 0.8 seconds Shen teleports to the ally and taunts nearby enemies for 0.75 seconds."
      },
      "archer": {
        "name": "Lucian",
        "attack": "Relic Pistols / Lightslinger: Fires a generated light bolt for 100% Attack physical damage. After Q, E, or R, the next attack within 4 seconds fires a second bolt 0.1 seconds later for 45% Attack physical damage.",
        "skill": "Q — Piercing Light: Targets an enemy unit and fires a fast, non-homing 760-range piercing light beam along the locked cast direction, dealing 55 + 85% Attack physical damage to every non-tower enemy hit. Activates Lightslinger.",
        "skill2": "E — Relentless Pursuit: Dashes 300 range in the chosen direction without dealing damage or spawning a release effect. Activates Lightslinger.",
        "ult": "R — The Culling: Stands still and fires 15 shots in the chosen direction, one every 0.13 seconds. Shots do not pierce; each deals 8 + 18% Attack physical damage to the first non-tower enemy hit. The channel can be interrupted and activates Lightslinger when it finishes."
      },
      "barrier_magician": {
        "name": "Orianna",
        "attack": "Clockwork Windup: Orianna's mechanical bolt deals 100% Attack physical damage plus 10 + 15% Ability Power magic damage.",
        "skill": "Q — Command: Attack + Dissonance: Sends the Ball to a targeted enemy champion and lands after 0.25 seconds, dealing 50 + 55% Ability Power magic damage in a 260-radius area. The non-persistent Ball leaves a fixed 300-radius field for 3 seconds: allies gain 18% Move Speed and enemies lose 22% Move Speed. From skill level 3, allies also gain 15% Attack Speed while enemies lose 15% Attack Speed.",
        "skill2": "E — Command: Protect: Sends the Ball to an allied champion, including Orianna, and grants a 180 + 55% Ability Power shield for 3 seconds. While that shield remains, the target gains 12 Defence and Magic Resistance, takes 15% less skill damage, and takes 10% less basic-attack damage. The Ball does not remain attached after the shield ends.",
        "ult": "R — Command: Shockwave: Places a shrinking ring at an enemy champion's current position. The ring stays fixed there while it contracts from 600 to 180 radius over 1 second and briefly binds enemies touching its edge. It then detonates at that fixed point, dealing 130 + 100% Ability Power magic damage, pulling enemies toward the point, and knocking them airborne for 0.4 seconds."
      },
      "berserker": {
        "name": "Briar",
        "attack": "Crimson Curse: Deals 100% Attack physical damage and applies a 2-second Bleed. Each Bleed ticks twice for 4 + 3% Attack physical damage and heals Briar for 2 + 1% Attack. Blood Frenzy empowers the next attack with 25 + 40% Attack plus 2% target maximum-health physical damage and heals 40 + 15% Attack, then consumes the empowerment.",
        "skill": "Q — Blood Frenzy: While an enemy champion is within 450 range, breaks the restraint for 3 seconds, gaining 60% Attack Speed, 18% Move Speed and 25 Vamp, and prepares one empowered bite. Cooldown: 6 seconds. This data-only version does not force a target or provide a manual second cast.",
        "skill2": "E — Chilling Scream: Performs a fixed 0.5-second charge, taking 35% less damage during the charge and healing 50 + 15% Attack once. The forward 500-range scream then deals 75 + 100% Attack physical damage, applies Crimson Curse, knocks enemies back and briefly knocks them airborne. Cooldown: 8 seconds; charge duration and wall impact cannot be varied.",
        "ult": "R — Certain Death: Selects an enemy champion within 800 range, warns them for 0.3 seconds, then rapidly chases them. On arrival Briar deals 100 + 120% Attack physical damage, applies Crimson Curse, fears nearby enemy champions for 0.5 seconds, and gains 4 seconds of enhanced frenzy with 50% Attack Speed, 25% Move Speed, 30 Vamp, 20 Defence, 20 Magic Resistance and 20 Toughness. Cooldown: 60 seconds. This first version is a targeted chase rather than a missable global projectile."
      },
      "boomerang_hunter": {
        "name": "Sivir",
        "attack": "Fleet of Foot: Throws a small crossblade for 100% Attack physical damage. Hitting any enemy grants 12% Move Speed for 1.5 seconds; repeated hits refresh this non-stacking buff.",
        "skill": "Q — Boomerang Blade: Throws a piercing crossblade 750 range. The outbound and returning passes each deal 30 + 55% Attack physical damage to non-tower enemies, so one target can be hit at most once per pass. Cooldown: 6 seconds; there is no pass-through damage falloff.",
        "skill2": "E — Spell Shield: Creates a 1.5-second window that reduces incoming skill damage by 100%, immediately heals Sivir for 60 + 15% Attack, and grants 20% Move Speed for 2 seconds. Cooldown: 12 seconds. This data version is a timed damage guard: it is not consumed by the first spell and cannot block crowd control or non-damage spell effects.",
        "ult": "R — On The Hunt: When an enemy champion is within 850 range, grants allied champions within 1000 range 25% Move Speed for 5 seconds. Cooldown: 50 seconds. It deals no damage and applies only one speed buff to Sivir."
      },
      "cavalry_knight": {
        "name": "Kled",
        "attack": "Halberd Thrust: Deals 100% Attack physical damage with Kled's halberd.",
        "skill": "Q — Bear Trap on a Rope: Fires a non-piercing bear trap in the chosen direction. The first enemy champion hit takes 30 + 80% Attack physical damage and is slowed by 20% for 0.75 seconds. After 0.75 seconds the tether deals another 20 + 40% Attack physical damage, pulls the same target toward Kled, and roots for 0.5 seconds. This data version does not recheck tether distance before the delayed pull. Cooldown: 6 seconds.",
        "skill2": "E — Jousting: Dashes in the chosen direction and stops on the first enemy champion hit, dealing 30 + 80% Attack physical damage. A successful hit grants Kled 20% Move Speed for 1 second. This data version has one dash and no second recast. Cooldown: 8 seconds.",
        "ult": "R — Chaaaaaaaarge!!!: Charges up to 1200 range, gaining 50% Move Speed, a 200 + 80% Attack shield, and brief crowd-control immunity. A straight trail lasts 4 seconds and grants other allied champions 25% Move Speed. The first enemy champion struck takes 80 + 100% Attack plus 2% maximum-Health physical damage and is knocked back and airborne. The data trail is straight and does not check ally travel direction."
      },
      "dancer": {
        "name": "Xayah",
        "attack": "Clean Cuts: A normal feather deals 100% Attack physical damage. After Q, E, or R, Xayah's next three attacks become piercing feathers: the selected target takes 65% Attack and the piercing line deals 35% Attack to non-tower enemies. Each empowered attack leaves one Feather, up to five.",
        "skill": "Q — Double Daggers: Throws two piercing feathers along the chosen direction, with the second launched 0.1 seconds later. Each feather deals 25 + 45% Attack physical damage and both together add two stored Feathers, up to five. Casting prepares three Clean Cuts. Cooldown: 6 seconds.",
        "skill2": "E — Bladecaller: As its own skill2 action, sends a fast invisible direction anchor and recalls the stored Feather count along that line. One Feather uses a single return, two use a double return, and three or more use the Bladecaller cluster. Damage scales from 20 + 25% Attack to 80 + 65% Attack; only the 3/4/5-Feather branches add a 0.75-second center root against non-tower enemies. Casting consumes the count and prepares three Clean Cuts. Cooldown: 12 seconds.",
        "ult": "R — Featherstorm: Xayah gains a 1-second damage and crowd-control safety window, then sends one wide, piercing fan forward for 80 + 70% Attack physical damage. It sets the stored Feather count to five and prepares three Clean Cuts; it never recalls Feathers or triggers E automatically. Cooldown: 50 seconds. The safety window approximates LoL untargetability without removing Xayah from the battlefield."
      },
      "demon": {
        "name": "Urgot",
        "attack": "Echoing Flames: Fires a basic shot for 100% Attack physical damage. Once every 2 seconds per Urgot, the shotgun legs add 20 + 30% Attack + 2% of the target's maximum Health as physical damage.",
        "skill": "W — Purge: Fires a stable compressed shot at one valid non-tower enemy, immediately dealing 96 + 240% Attack physical damage. Urgot then loses 12% Move Speed and gains 20 Defence and 10 Magic Resistance for 4 seconds. Cooldown: 10 seconds.",
        "skill2": "E — Disdain: Gains a 160 + 70% Attack shield for 3 seconds, rushes behind a targeted enemy champion, deals 70 + 90% Attack physical damage, stuns for 1 second and flings the target behind him. Cooldown: 7 seconds.",
        "ult": "R — Fear Beyond Death: Fires a non-piercing drill up to 900 range. The first enemy champion hit takes 80 + 60% Attack physical damage and is slowed by 35% for 1.5 seconds. After 0.75 seconds Urgot reels the victim in; if their current Health is 25% or lower at that moment, he executes them. Only a successful execution deals 30 + 30% Attack physical damage and fears enemy champions within 320 range for 0.75 seconds. Cooldown: 50 seconds."
      },
      "dual_blader": {
        "name": "Yone",
        "attack": "Way of the Hunter: Basic attacks alternate between the steel blade and Azakana blade, each dealing 100% Attack physical damage.",
        "skill": "Q — Mortal Steel: Rush 25000 units in the chosen direction, dealing 75 + 80% Attack physical damage, knocking enemies airborne for 0.75 seconds, and healing for 5% Attack per enemy hit. Cooldown: 5 seconds.",
        "skill2": "W — Spirit Cleave: Send a wide blade wave 35000 units forward, dealing 80 + 80% Attack physical damage and knocking enemies back. Each enemy hit grants a 3-second, 20 + 20% Attack shield. Cooldown: 8 seconds.",
        "ult": "R — Fate Sealed: After a brief wind-up, dash through every enemy in a line for 120 + 70% Attack physical damage, knock them airborne for 0.75 seconds, then pull them together. Cooldown: 50 seconds."
      }
    }
  },
  "zh-hans": {
    "description": {
      "lol_shen": {
        "name": "慎",
        "attack": "忍刃：慎进行稳定的近战攻击，造成100%攻击力的物理伤害。",
        "skill": "Q—暮光斩：灵刃穿过敌人，造成40 + 60%法术强度的魔法伤害，并减速25%，持续1.5秒。命中敌人后，慎获得120点护盾，持续2秒。",
        "skill2": "W—灵佑领域：慎在身边展开防御领域。范围内友方英雄获得150 + 40%法术强度的护盾，持续2.5秒；敌方英雄的攻击速度降低30%，持续2秒。",
        "ult": "R—秘奥义！慈悲度魂落：为远处友方英雄提供900 + 80%法术强度的护盾，持续3秒。0.8秒后慎传送至其身边，并嘲讽附近敌人0.75秒。"
      },
      "archer": {
        "name": "卢锡安",
        "attack": "遗迹圣枪／圣光银弹：发射生成的圣光弹，造成100%攻击力的物理伤害。施放Q、E或R后，4秒内的下一次普攻会在0.1秒后追加第二发子弹，造成45%攻击力的物理伤害。",
        "skill": "Q—透体圣光：锁定一名敌方单位，沿施法时确定的方向发射一道快速且不会追踪的760距离贯穿光束，对命中的所有非防御塔敌人造成55 + 85%攻击力的物理伤害，并激活圣光银弹。",
        "skill2": "E—冷酷追击：向指定方向冲刺300距离，不造成伤害，也不会生成释放特效；激活圣光银弹。",
        "ult": "R—圣枪洗礼：原地朝指定方向连续发射15发不可穿透的子弹，每0.13秒一发。每发对首个命中的非防御塔敌人造成8 + 18%攻击力的物理伤害。引导可被打断，结束后激活圣光银弹。"
      },
      "barrier_magician": {
        "name": "奥利安娜",
        "attack": "发条协奏：奥利安娜的机械弹造成100%攻击力的物理伤害，并额外造成10 + 15%法术强度的魔法伤害。",
        "skill": "Q—指令：进攻·杂音：将魔偶送向目标敌方英雄，0.25秒后落地，对260半径内的敌人造成50 + 55%法术强度的魔法伤害。魔偶不会持续存在，但会在落点留下固定的300半径力场，持续3秒：友军移动速度提高18%，敌军移动速度降低22%。技能达到3级后，友军攻击速度再提高15%，敌军攻击速度降低15%。",
        "skill2": "E—指令：防卫：将魔偶送向一名友方英雄（可以选择奥利安娜），提供180 + 55%法术强度的护盾，持续3秒。护盾存在期间，目标获得12点护甲和魔法抗性，受到的技能伤害降低15%，受到的普通攻击伤害降低10%。护盾结束后魔偶不会继续附着。",
        "ult": "R—指令：冲击波：在一名敌方英雄当前所在位置放置圆环。圆环固定在该落点，1秒内从600半径缩至180半径，触碰边缘的敌人会被短暂禁锢；随后在该固定点引爆，造成130 + 100%法术强度的魔法伤害，将敌人拉向中心并击飞0.4秒。"
      },
      "berserker": {
        "name": "贝蕾亚",
        "attack": "血色诅咒：造成100%攻击力的物理伤害，并施加持续2秒的流血。每层流血结算2次，每次造成4 + 3%攻击力的物理伤害，并为贝蕾亚回复2 + 1%攻击力的生命。血莽会强化下一次普攻：额外造成25 + 40%攻击力 + 目标2%最大生命值的物理伤害，回复40 + 15%攻击力的生命，随后消耗强化。",
        "skill": "Q—血莽：450距离内存在敌方英雄时挣脱拘束，持续3秒；获得60%攻击速度、18%移动速度和25点全能吸血，并准备一次强化噬击。冷却6秒。数据版本不会强制锁定目标，也没有可手动施放的二段技能。",
        "skill2": "E—惊吼：固定蓄力0.5秒，蓄力期间受到的伤害降低35%，并且每次施放只回复一次50 + 15%攻击力的生命。随后向前方500距离释放冲击，造成75 + 100%攻击力的物理伤害、施加血色诅咒、击退并短暂击飞敌人。冷却8秒；无法改变蓄力时长，也没有撞墙奖励。",
        "ult": "R—必死无疑：选择800距离内一名敌方英雄，预警0.3秒后高速追击。到达时造成100 + 120%攻击力的物理伤害并施加血色诅咒，使附近敌方英雄恐惧0.5秒；随后获得4秒强化狂暴：50%攻击速度、25%移动速度、30点全能吸血、20点护甲、20点魔抗和20点韧性。冷却60秒。首版是锁定追击，不是可以放空的全图直线弹体。"
      },
      "boomerang_hunter": {
        "name": "希维尔",
        "attack": "敏锐疾行：投出小型十字刃，造成100%攻击力的物理伤害。命中任意敌人后获得12%移动速度，持续1.5秒；重复命中只刷新持续时间，不叠加。",
        "skill": "Q—回旋之刃：向前投出可穿透敌人的十字刃，射程750。飞出和返回各对非防御塔敌人造成30 + 55%攻击力的物理伤害，同一目标每段最多命中一次。冷却6秒；穿透伤害不衰减。",
        "skill2": "E—法术护盾：展开1.5秒防护窗口，受到的技能伤害降低100%；施放时立即回复60 + 15%攻击力的生命，并获得20%移动速度，持续2秒。冷却12秒。数据版本是限时技能伤害防护，不会在挡住第一次技能后消耗，也不能阻挡控制或无伤害技能效果。",
        "ult": "R—狩猎：850距离内存在敌方英雄时，使1000范围内友方英雄获得25%移动速度，持续5秒。冷却50秒；不造成伤害，希维尔本人只获得一份加速。"
      },
      "cavalry_knight": {
        "name": "克烈",
        "attack": "长戟突刺：克烈挥动长戟，造成100%攻击力的物理伤害。",
        "skill": "Q—飞索捕熊器：向指定方向发射一枚不可穿透的捕熊器。命中的首名敌方英雄受到30 + 80%攻击力的物理伤害，并减速20%，持续0.75秒。0.75秒后，飞索对同一目标再次造成20 + 40%攻击力的物理伤害，将其拉向克烈并定身0.5秒。数据版本在延迟拉回前不会重新检查飞索距离。冷却6秒。",
        "skill2": "E—比武：向指定方向冲刺，在命中的首名敌方英雄处停止并造成30 + 80%攻击力的物理伤害。命中后克烈的移动速度提高20%，持续1秒。数据版本只有一次冲刺，没有第二段重施。冷却8秒。",
        "ult": "R—冲啊——！！！：最远冲锋1200距离，获得50%移动速度、200 + 80%攻击力的护盾和短暂控制免疫。身后留下持续4秒的直线路线，使路线上的其他友方英雄移速提高25%。撞到首名敌方英雄时造成80 + 100%攻击力 + 目标2%最大生命值的物理伤害，并将其小幅击退和击飞。数据路线不会转弯，也不检查友军移动方向。"
      },
      "dancer": {
        "name": "霞",
        "attack": "锐切：普通羽刃造成100%攻击力的物理伤害。施放Q、E或R后，霞的下三次普攻变为穿透羽刃：选中目标受到65%攻击力伤害，直线上的非防御塔敌人受到35%攻击力伤害。每次强化普攻留下一枚羽毛，最多5枚。",
        "skill": "Q—双刃：朝指定方向投出两枚可穿透的羽刃，第二枚在0.1秒后发射。每枚造成25 + 45%攻击力的物理伤害，并使储存羽毛增加2枚，最多5枚。施放后准备三次锐切。冷却6秒。",
        "skill2": "E—倒钩：作为独立的skill2技能，先朝指定方向放出高速不可见定位投射物，再按储存羽毛数量沿该直线召回。1枚显示单羽、2枚显示双羽、3枚及以上显示倒钩羽簇；伤害从20 + 25%攻击力提高至80 + 65%攻击力，只有3/4/5枚分支会对非防御塔敌人额外产生0.75秒中心定身。施放会消耗羽毛计数并准备三次锐切。冷却12秒。",
        "ult": "R—暴风羽刃：霞获得1秒的伤害与控制防护窗口，随后向前发射一片宽阔且可穿透的羽刃扇形，造成80 + 70%攻击力的物理伤害。技能把储存羽毛设为5枚并准备三次锐切，绝不会自动召回羽毛或自动触发E。冷却50秒。防护窗口是数据系统对《英雄联盟》不可被选取效果的近似实现，霞仍留在战场上。"
      },
      "demon": {
        "name": "厄加特",
        "attack": "回响烈焰：普攻造成100%攻击力的物理伤害。每个厄加特拥有独立的2秒散弹腿冷却；就绪时额外造成20 + 30%攻击力 + 目标2%最大生命值的物理伤害。",
        "skill": "W—净除：向一个合法的非防御塔敌人发射一次稳定的压缩射击，立即造成96 + 240%攻击力的物理伤害。随后厄加特在4秒内移动速度降低12%，护甲提高20，魔抗提高10。冷却10秒。",
        "skill2": "E—鄙弃：获得160 + 70%攻击力的护盾，持续3秒；随后冲到目标敌方英雄身后，造成70 + 90%攻击力的物理伤害、眩晕1秒，并把目标背摔到自己身后。冷却7秒。",
        "ult": "R—超越死亡的恐惧：发射一枚最远900距离、不可穿透的钻头。首名命中的敌方英雄受到80 + 60%攻击力的物理伤害，并被减速35%，持续1.5秒。0.75秒后将目标拉回；若此时目标当前生命值不高于25%，则真实斩杀。只有斩杀实际成功后，才会对自身320范围内敌方英雄造成30 + 30%攻击力的物理伤害并恐惧0.75秒。冷却50秒。"
      },
      "dual_blader": {
        "name": "永恩",
        "attack": "狩人之道：普攻在钢剑与亚扎卡纳之剑间交替，每次造成100%攻击力的物理伤害。",
        "skill": "Q—错玉切：朝指定方向突进25000距离，对沿途敌人造成75+80%攻击力物理伤害并击飞0.75秒；每命中1名敌人回复5%攻击力的生命值。冷却5秒。",
        "skill2": "W—凛神斩：向前释放35000距离的宽幅剑气，造成80+80%攻击力物理伤害并击退敌人；每命中1名敌人获得持续3秒的20+20%攻击力护盾。冷却8秒。",
        "ult": "R—封尘绝念斩：短暂蓄力后贯穿直线上的所有敌人，造成120+70%攻击力物理伤害并击飞0.75秒，随后将其拉拢。冷却50秒。"
      }
    }
  },
  "zh-hant": {
    "description": {
      "lol_shen": {
        "name": "慎",
        "attack": "忍刃：慎進行穩定的近戰攻擊，造成100%攻擊力的物理傷害。",
        "skill": "Q—暮光斬：靈刃穿過敵人，造成40 + 60%法術強度的魔法傷害，並減速25%，持續1.5秒。命中敵人後，慎獲得120點護盾，持續2秒。",
        "skill2": "W—靈佑領域：慎在身邊展開防禦領域。範圍內友方英雄獲得150 + 40%法術強度的護盾，持續2.5秒；敵方英雄的攻擊速度降低30%，持續2秒。",
        "ult": "R—秘奧義！慈悲度魂落：為遠處友方英雄提供900 + 80%法術強度的護盾，持續3秒。0.8秒後慎傳送至其身邊，並嘲諷附近敵人0.75秒。"
      },
      "archer": {
        "name": "路西恩",
        "attack": "遺跡聖槍／聖光銀彈：發射生成的聖光彈，造成100%攻擊力的物理傷害。施放Q、E或R後，4秒內的下一次普攻會在0.1秒後追加第二發子彈，造成45%攻擊力的物理傷害。",
        "skill": "Q—透體聖光：鎖定一名敵方單位，沿施法時確定的方向發射一道快速且不會追蹤的760距離貫穿光束，對命中的所有非防禦塔敵人造成55 + 85%攻擊力的物理傷害，並啟動聖光銀彈。",
        "skill2": "E—冷酷追擊：向指定方向衝刺300距離，不造成傷害，也不會產生施放特效；啟動聖光銀彈。",
        "ult": "R—聖槍洗禮：原地朝指定方向連續發射15發不可穿透的子彈，每0.13秒一發。每發對首個命中的非防禦塔敵人造成8 + 18%攻擊力的物理傷害。引導可被打斷，結束後啟動聖光銀彈。"
      },
      "barrier_magician": {
        "name": "奧利安娜",
        "attack": "發條協奏：奧利安娜的機械彈造成100%攻擊力的物理傷害，並額外造成10 + 15%魔法攻擊的魔法傷害。",
        "skill": "Q—指令：攻擊・雜音：將魔偶送向目標敵方英雄，0.25秒後落地，對260半徑內的敵人造成50 + 55%魔法攻擊的魔法傷害。魔偶不會持續存在，但會在落點留下固定的300半徑力場，持續3秒：隊友移動速度提高18%，敵人移動速度降低22%。技能達到3級後，隊友攻擊速度再提高15%，敵人攻擊速度降低15%。",
        "skill2": "E—指令：防衛：將魔偶送向一名友方英雄（可選擇奧利安娜），提供180 + 55%魔法攻擊的護盾，持續3秒。護盾存在期間，目標獲得12點護甲和魔法抗性，受到的技能傷害降低15%，受到的普通攻擊傷害降低10%。護盾結束後魔偶不會繼續附著。",
        "ult": "R—指令：衝擊波：在一名敵方英雄目前所在位置放置圓環。圓環固定在該落點，1秒內從600半徑縮至180半徑，觸碰邊緣的敵人會被短暫禁錮；隨後在該固定點引爆，造成130 + 100%魔法攻擊的魔法傷害，將敵人拉向中心並擊飛0.4秒。"
      },
      "berserker": {
        "name": "貝蕾亞",
        "attack": "血色詛咒：造成100%攻擊力的物理傷害，並施加持續2秒的流血。每層流血結算2次，每次造成4 + 3%攻擊力的物理傷害，並為貝蕾亞回復2 + 1%攻擊力的生命。血莽會強化下一次普攻：額外造成25 + 40%攻擊力 + 目標2%最大生命的物理傷害，回復40 + 15%攻擊力的生命，隨後消耗強化。",
        "skill": "Q—血莽：450距離內存在敵方英雄時掙脫拘束，持續3秒；獲得60%攻擊速度、18%移動速度和25點全能吸血，並準備一次強化噬擊。冷卻6秒。資料版本不會強制鎖定目標，也沒有可手動施放的二段技能。",
        "skill2": "E—驚吼：固定蓄力0.5秒，蓄力期間受到的傷害降低35%，並且每次施放只回復一次50 + 15%攻擊力的生命。隨後向前方500距離釋放衝擊，造成75 + 100%攻擊力的物理傷害、施加血色詛咒、擊退並短暫擊飛敵人。冷卻8秒；無法改變蓄力時間，也沒有撞牆獎勵。",
        "ult": "R—必死無疑：選擇800距離內一名敵方英雄，預警0.3秒後高速追擊。到達時造成100 + 120%攻擊力的物理傷害並施加血色詛咒，使附近敵方英雄恐懼0.5秒；隨後獲得4秒強化狂暴：50%攻擊速度、25%移動速度、30點全能吸血、20點護甲、20點魔抗和20點韌性。冷卻60秒。首版是鎖定追擊，不是可以放空的全圖直線彈體。"
      },
      "boomerang_hunter": {
        "name": "希維爾",
        "attack": "敏銳疾行：投出小型十字刃，造成100%攻擊力的物理傷害。命中任意敵人後獲得12%移動速度，持續1.5秒；重複命中只刷新持續時間，不疊加。",
        "skill": "Q—迴旋之刃：向前投出可穿透敵人的十字刃，射程750。飛出和返回各對非防禦塔敵人造成30 + 55%攻擊力的物理傷害，同一目標每段最多命中一次。冷卻6秒；穿透傷害不衰減。",
        "skill2": "E—法術護盾：展開1.5秒防護窗口，受到的技能傷害降低100%；施放時立即回復60 + 15%攻擊力的生命，並獲得20%移動速度，持續2秒。冷卻12秒。資料版本是限時技能傷害防護，不會在擋住第一次技能後消耗，也不能阻擋控制或無傷害技能效果。",
        "ult": "R—狩獵：850距離內存在敵方英雄時，使1000範圍內友方英雄獲得25%移動速度，持續5秒。冷卻50秒；不造成傷害，希維爾本人只獲得一份加速。"
      },
      "cavalry_knight": {
        "name": "克烈",
        "attack": "長戟突刺：克烈揮動長戟，造成100%攻擊力的物理傷害。",
        "skill": "Q—飛索捕熊器：向指定方向發射一枚不可穿透的捕熊器。命中的首名敵方英雄受到30 + 80%攻擊力的物理傷害，並減速20%，持續0.75秒。0.75秒後，飛索對同一目標再次造成20 + 40%攻擊力的物理傷害，將其拉向克烈並定身0.5秒。資料版本在延遲拉回前不會重新檢查飛索距離。冷卻6秒。",
        "skill2": "E—比武：向指定方向衝刺，在命中的首名敵方英雄處停止並造成30 + 80%攻擊力的物理傷害。命中後克烈的移動速度提高20%，持續1秒。資料版本只有一次衝刺，沒有第二段重施。冷卻8秒。",
        "ult": "R—衝啊——！！！：最遠衝鋒1200距離，獲得50%移動速度、200 + 80%攻擊力的護盾和短暫控制免疫。身後留下持續4秒的直線路線，使路線上的其他友方英雄移速提高25%。撞到首名敵方英雄時造成80 + 100%攻擊力 + 目標2%最大生命值的物理傷害，並將其小幅擊退和擊飛。資料路線不會轉彎，也不檢查友軍移動方向。"
      },
      "dancer": {
        "name": "剎雅",
        "attack": "銳切：普通羽刃造成100%攻擊力的物理傷害。施放Q、E或R後，剎雅的下三次普攻變為穿透羽刃：選中目標受到65%攻擊力傷害，直線上的非防禦塔敵人受到35%攻擊力傷害。每次強化普攻留下一枚羽毛，最多5枚。",
        "skill": "Q—雙刃：朝指定方向投出兩枚可穿透的羽刃，第二枚在0.1秒後發射。每枚造成25 + 45%攻擊力的物理傷害，並使儲存羽毛增加2枚，最多5枚。施放後準備三次銳切。冷卻6秒。",
        "skill2": "E—倒鉤：作為獨立的skill2技能，先朝指定方向放出高速不可見定位投射物，再按儲存羽毛數量沿該直線召回。1枚顯示單羽、2枚顯示雙羽、3枚及以上顯示倒鉤羽簇；傷害從20 + 25%攻擊力提高至80 + 65%攻擊力，只有3/4/5枚分支會對非防禦塔敵人額外產生0.75秒中心定身。施放會消耗羽毛計數並準備三次銳切。冷卻12秒。",
        "ult": "R—暴風羽刃：剎雅獲得1秒的傷害與控制防護窗口，隨後向前發射一片寬闊且可穿透的羽刃扇形，造成80 + 70%攻擊力的物理傷害。技能把儲存羽毛設為5枚並準備三次銳切，絕不會自動召回羽毛或自動觸發E。冷卻50秒。防護窗口是資料系統對《英雄聯盟》不可被選取效果的近似實作，剎雅仍留在戰場上。"
      },
      "demon": {
        "name": "厄加特",
        "attack": "迴響烈焰：普攻造成100%攻擊力的物理傷害。每個厄加特擁有獨立的2秒散彈腿冷卻；就緒時額外造成20 + 30%攻擊力 + 目標2%最大生命值的物理傷害。",
        "skill": "W—淨除：向一個合法的非防禦塔敵人發射一次穩定的壓縮射擊，立即造成96 + 240%攻擊力的物理傷害。隨後厄加特在4秒內移動速度降低12%，護甲提高20，魔抗提高10。冷卻10秒。",
        "skill2": "E—鄙棄：獲得160 + 70%攻擊力的護盾，持續3秒；隨後衝到目標敵方英雄身後，造成70 + 90%攻擊力的物理傷害、暈眩1秒，並把目標背摔到自己身後。冷卻7秒。",
        "ult": "R—超越死亡的恐懼：發射一枚最遠900距離、不可穿透的鑽頭。首名命中的敵方英雄受到80 + 60%攻擊力的物理傷害，並被減速35%，持續1.5秒。0.75秒後將目標拉回；若此時目標當前生命值不高於25%，則真正處決。只有處決實際成功後，才會對自身320範圍內敵方英雄造成30 + 30%攻擊力的物理傷害並恐懼0.75秒。冷卻50秒。"
      },
      "dual_blader": {
        "name": "犽凝",
        "attack": "狩人之道：普攻在鋼劍與亞扎卡納之劍間交替，每次造成100%攻擊力的物理傷害。",
        "skill": "Q—錯玉切：朝指定方向突進25000距離，對沿途敵人造成75+80%攻擊力物理傷害並擊飛0.75秒；每命中1名敵人回復5%攻擊力的生命值。冷卻5秒。",
        "skill2": "W—凜神斬：向前釋放35000距離的寬幅劍氣，造成80+80%攻擊力物理傷害並擊退敵人；每命中1名敵人獲得持續3秒的20+20%攻擊力護盾。冷卻8秒。",
        "ult": "R—封塵絕念斬：短暫蓄力後貫穿直線上的所有敵人，造成120+70%攻擊力物理傷害並擊飛0.75秒，隨後將其拉攏。冷卻50秒。"
      }
    }
  },
  "ja": {
    "description": {
      "lol_shen": {
        "name": "シェン",
        "attack": "忍刀：攻撃力100%の物理ダメージを与える。",
        "skill": "Q—暮光斬：霊剣を前方へ放ち、40 + 魔力60%の魔法ダメージを与え、1.5秒間25%スロウにする。命中すると2秒間120のシールドを得る。",
        "skill2": "W—護刃の結界：周囲に防御領域を展開する。味方は2.5秒間150 + 魔力40%のシールドを得て、敵は2秒間攻撃速度が30%低下する。",
        "ult": "R—瞬身護法：遠くの味方に3秒間900 + 魔力80%のシールドを付与する。0.8秒後その味方へテレポートし、周囲の敵を0.75秒間タウントする。"
      },
      "barrier_magician": {
        "name": "オリアナ",
        "attack": "ぜんまい仕掛け：オリアナの機械弾は攻撃力100%の物理ダメージに加え、10 + 魔力15%の魔法ダメージを与える。",
        "skill": "Q—オーダー：攻撃＋不協和音：対象の敵チャンピオンへボールを送り、0.25秒後に着弾して半径260以内の敵に50 + 魔力55%の魔法ダメージを与える。ボールは残らないが、着弾地点に半径300の固定フィールドを3秒間残し、味方の移動速度を18%上げ、敵の移動速度を22%下げる。スキルレベル3以降は味方の攻撃速度も15%上げ、敵の攻撃速度を15%下げる。",
        "skill2": "E—オーダー：防御：オリアナ自身を含む味方チャンピオンへボールを送り、180 + 魔力55%のシールドを3秒間付与する。シールドがある間、対象は防御力と魔法耐性を12得て、スキルダメージを15%、通常攻撃ダメージを10%軽減する。シールド終了後、ボールは付着したままにならない。",
        "ult": "R—オーダー：ショックウェーブ：敵チャンピオンの現在位置にリングを置く。リングはその着地点に固定されたまま1秒かけて半径600から180まで縮み、縁に触れた敵を短時間拘束する。その後、固定地点で爆発し、130 + 魔力100%の魔法ダメージを与え、敵を中心へ引き寄せて0.4秒間ノックアップする。"
      },
      "berserker": {
        "name": "ブライアー",
        "attack": "真紅の呪い：攻撃力100%の物理ダメージを与え、2秒間の出血を付与する。出血は2回発動し、1回ごとに4 + 攻撃力3%の物理ダメージを与え、ブライアーの体力を2 + 攻撃力1%回復する。血の狂乱後の次の通常攻撃は追加で25 + 攻撃力40% + 対象の最大体力2%の物理ダメージを与え、40 + 攻撃力15%回復して強化を消費する。",
        "skill": "Q—血の狂乱：450以内に敵チャンピオンがいる場合、3秒間拘束を解き、攻撃速度60%、移動速度18%、ヴァンプ25を得て、強化された噛みつきを1回準備する。クールダウン6秒。データ版では対象を強制せず、手動の再発動もない。",
        "skill2": "E—身震いする叫び：0.5秒固定で溜め、その間受けるダメージを35%軽減し、1回だけ50 + 攻撃力15%回復する。前方500へ75 + 攻撃力100%の物理ダメージを与え、真紅の呪い、ノックバック、短いノックアップを付与する。クールダウン8秒。溜め時間変更と壁衝突ボーナスはない。",
        "ult": "R—死の確定：800以内の敵チャンピオンを選び、0.3秒の警告後に高速追跡する。到達時に100 + 攻撃力120%の物理ダメージと真紅の呪いを与え、周囲の敵チャンピオンを0.5秒恐怖させ、4秒間の強化狂乱を得る。クールダウン60秒。初版は外れる直線弾ではなく対象指定の追跡である。"
      },
      "boomerang_hunter": {
        "name": "シヴィア",
        "attack": "フリート・オブ・フット：小型クロスブレードで攻撃力100%の物理ダメージを与える。敵に命中すると1.5秒間移動速度が12%上がり、再命中は重複せず時間だけ更新する。",
        "skill": "Q—ブーメランブレード：射程750の貫通する刃を投げる。往路と復路はそれぞれ30 + 攻撃力55%の物理ダメージを与え、同じ対象には各区間1回まで命中する。クールダウン6秒。",
        "skill2": "E—スペルシールド：1.5秒間スキルダメージを100%軽減し、発動時に60 + 攻撃力15%回復して2秒間移動速度が20%上がる。クールダウン12秒。データ版は時間制の軽減で、最初のスキルで消費されず、妨害や非ダメージ効果は防げない。",
        "ult": "R—戦姫の号令：敵チャンピオンが850以内にいる時、1000以内の味方チャンピオンの移動速度を5秒間25%上げる。クールダウン50秒。ダメージはなく、シヴィア自身への強化は1つだけ。"
      },
      "cavalry_knight": {
        "name": "クレッド",
        "attack": "ハルバード突き：クレッドがハルバードで攻撃し、攻撃力100%の物理ダメージを与える。",
        "skill": "Q—トラバサミロープ：指定方向へ貫通しないトラバサミを投げる。最初に命中した敵チャンピオンへ30 + 攻撃力80%の物理ダメージを与え、0.75秒間20%スロウにする。0.75秒後、同じ対象へ20 + 攻撃力40%の追加物理ダメージを与え、クレッドへ引き寄せて0.5秒間拘束する。データ版は遅延プルの前に距離を再判定しない。クールダウン6秒。",
        "skill2": "E—ジャウスト：指定方向へダッシュし、最初に命中した敵チャンピオンで停止して30 + 攻撃力80%の物理ダメージを与える。命中時、クレッドの移動速度が1秒間20%上昇する。データ版は1回のダッシュのみで再発動はない。クールダウン8秒。",
        "ult": "R—チャァァァァァァジ！！！：最大1200まで突進し、移動速度50%、200 + 攻撃力80%のシールド、短い妨害無効を得る。4秒間の直線軌跡は他の味方の移動速度を25%上げる。最初に衝突した敵チャンピオンへ80 + 攻撃力100% + 最大体力2%の物理ダメージを与え、ノックバックとノックアップを行う。軌跡は曲がらず、味方の移動方向も判定しない。"
      },
      "dancer": {
        "name": "ザヤ",
        "attack": "クリーンカット：通常の羽根は攻撃力100%の物理ダメージを与える。Q、E、Rの後、次の3回の通常攻撃は貫通羽根となり、対象へ攻撃力65%、直線上のタワー以外の敵へ攻撃力35%のダメージを与える。強化攻撃ごとに羽根を1枚残し、最大5枚。",
        "skill": "Q—ダブルダガー：指定方向へ貫通する羽根を2枚投げ、2枚目は0.1秒後に発射する。各羽根は25 + 攻撃力45%の物理ダメージを与え、保存羽根を2枚増やして最大5枚にする。発動後はクリーンカットを3回準備する。クールダウン6秒。",
        "skill2": "E—ブレードコーラー：独立したskill2として不可視の方向アンカーを出し、保存羽根数を同じ直線で回収する。1枚は単羽、2枚は双羽、3枚以上はクラスター表示となり、ダメージは20 + 攻撃力25%から80 + 攻撃力65%まで増加する。3/4/5枚の分岐だけが中心線を0.75秒拘束する。羽根数を消費し、クリーンカットを3回準備する。クールダウン12秒。",
        "ult": "R—フェザーストーム：1秒間ダメージと妨害に対する防護を得た後、幅広い貫通羽根の扇を前方へ放ち、80 + 攻撃力70%の物理ダメージを与える。保存羽根を5枚にし、クリーンカットを3回準備する。羽根の呼び戻しやEの自動発動は行わない。クールダウン50秒。防護はLoLの対象指定不可を近似したもので、ザヤは戦場から消えない。"
      },
      "demon": {
        "name": "アーゴット",
        "attack": "エコーフレイム：通常攻撃は攻撃力100%の物理ダメージを与える。アーゴットごとに2秒のショットガン脚クールダウンを持ち、準備完了時は20 + 攻撃力30% + 対象の最大体力2%の追加物理ダメージを与える。",
        "skill": "W—パージ：有効なタワー以外の敵1体に安定した圧縮射撃を行い、即座に96 + 攻撃力の240%の物理ダメージを与える。その後4秒間、移動速度-12%、防御+20、魔法耐性+10。クールダウン10秒。",
        "skill2": "E—ディスデイン：3秒間160 + 攻撃力70%のシールドを得て、対象の敵チャンピオンの背後へ突進する。70 + 攻撃力90%の物理ダメージ、1秒スタンを与え、対象を自分の背後へ投げる。クールダウン7秒。",
        "ult": "R—デスグラインダー：最大900の非貫通ドリルを撃ち、最初の敵チャンピオンへ80 + 攻撃力60%の物理ダメージと1.5秒間35%スロウを与える。0.75秒後に引き寄せ、その時点の現在体力が25%以下なら処刑する。実際に処刑できた場合のみ、周囲320の敵チャンピオンへ30 + 攻撃力30%の物理ダメージと0.75秒の恐怖を与える。クールダウン50秒。"
      },
      "dual_blader": {
        "name": "ヨネ",
        "attack": "狩人の道：通常攻撃は鋼の剣とアザカナの剣を交互に使い、攻撃力100%の物理ダメージを与える。",
        "skill": "Q—斬命刀：指定方向へ25000突進し、敵に75+攻撃力80%の物理ダメージと0.75秒のノックアップを与える。命中した敵1体につき攻撃力5%分を回復する。クールダウン5秒。",
        "skill2": "W—霊断刀：前方へ35000の幅広い刃の波を放ち、80+攻撃力80%の物理ダメージとノックバックを与える。敵1体に命中するたび、3秒間20+攻撃力20%のシールドを得る。クールダウン8秒。",
        "ult": "R—運命の封印：短い溜めの後、直線上の全敵をすり抜けて120+攻撃力70%の物理ダメージを与え、0.75秒ノックアップしてから一か所へ引き寄せる。クールダウン50秒。"
      }
    }
  },
  "ko": {
    "description": {
      "lol_shen": {
        "name": "쉔",
        "attack": "닌자 검: 공격력의 100%만큼 물리 피해를 입힙니다.",
        "skill": "Q—황혼 베기: 영혼의 검을 전방으로 보내 40 + 주문력의 60%만큼 마법 피해를 입히고 1.5초 동안 25% 둔화시킵니다. 적중하면 2초 동안 120의 보호막을 얻습니다.",
        "skill2": "W—의지의 결계: 주변에 방어 지대를 펼칩니다. 아군은 2.5초 동안 150 + 주문력의 40%만큼 보호막을 얻고, 적은 2초 동안 공격 속도가 30% 감소합니다.",
        "ult": "R—단결된 의지: 멀리 있는 아군에게 3초 동안 900 + 주문력의 80%만큼 보호막을 부여합니다. 0.8초 후 해당 아군에게 순간이동해 주변 적을 0.75초 동안 도발합니다."
      },
      "barrier_magician": {
        "name": "오리아나",
        "attack": "시계태엽 감기: 오리아나의 기계 탄환이 공격력의 100%만큼 물리 피해를 입히고 10 + 주문력의 15%만큼 추가 마법 피해를 입힙니다.",
        "skill": "Q—명령: 공격 + 불협화음: 대상 적 챔피언에게 구체를 보내 0.25초 후 착지시키고 반경 260 안의 적에게 50 + 주문력의 55%만큼 마법 피해를 입힙니다. 구체는 지속되지 않지만 착지 지점에 반경 300의 고정 역장을 3초 동안 남겨 아군 이동 속도를 18% 높이고 적 이동 속도를 22% 낮춥니다. 스킬 레벨 3부터 아군 공격 속도도 15% 높이고 적 공격 속도를 15% 낮춥니다.",
        "skill2": "E—명령: 보호: 오리아나 자신을 포함한 아군 챔피언에게 구체를 보내 180 + 주문력의 55%만큼 보호막을 3초 동안 부여합니다. 보호막이 유지되는 동안 대상은 방어력과 마법 저항력 12를 얻고 스킬 피해를 15%, 기본 공격 피해를 10% 덜 받습니다. 보호막이 끝나면 구체는 계속 부착되어 있지 않습니다.",
        "ult": "R—명령: 충격파: 적 챔피언의 현재 위치에 고리를 놓습니다. 고리는 그 착지점에 고정된 채 1초 동안 반경 600에서 180으로 줄어들며 가장자리에 닿은 적을 잠시 속박합니다. 이후 고정된 지점에서 폭발해 130 + 주문력의 100%만큼 마법 피해를 입히고 적을 중심으로 끌어당긴 뒤 0.4초 동안 공중에 띄웁니다."
      },
      "berserker": {
        "name": "브라이어",
        "attack": "핏빛 저주: 공격력의 100%만큼 물리 피해를 입히고 2초 출혈을 부여합니다. 출혈은 두 번 발동해 매번 4 + 공격력의 3%만큼 피해를 입히고 브라이어가 2 + 공격력의 1%만큼 회복합니다. 핏빛 광분 후 다음 기본 공격은 25 + 공격력의 40% + 대상 최대 체력의 2%만큼 추가 피해를 입히고 40 + 공격력의 15%만큼 회복한 뒤 강화를 소모합니다.",
        "skill": "Q—핏빛 광분: 450 안에 적 챔피언이 있으면 3초 동안 구속을 깨고 공격 속도 60%, 이동 속도 18%, 모든 피해 흡혈 25를 얻으며 강화된 물어뜯기 1회를 준비합니다. 재사용 대기시간 6초. 데이터 버전은 대상을 강제하지 않고 수동 재사용도 없습니다.",
        "skill2": "E—오싹한 비명: 0.5초 고정 충전 중 받는 피해가 35% 감소하고 한 번만 50 + 공격력의 15%만큼 회복합니다. 전방 500에 75 + 공격력의 100%만큼 물리 피해를 입히고 핏빛 저주, 밀쳐내기, 짧은 공중 띄우기를 적용합니다. 재사용 대기시간 8초. 충전 시간 변경과 벽 충돌 보너스는 없습니다.",
        "ult": "R—불가항력적 죽음: 800 안의 적 챔피언을 선택해 0.3초 경고 후 빠르게 추격합니다. 도착 시 100 + 공격력의 120%만큼 물리 피해와 핏빛 저주를 적용하고 주변 적 챔피언을 0.5초 공포에 빠뜨린 뒤 4초 강화 광분을 얻습니다. 재사용 대기시간 60초. 첫 버전은 빗나갈 수 있는 전역 투사체가 아니라 대상 지정 추격입니다."
      },
      "boomerang_hunter": {
        "name": "시비르",
        "attack": "재빠른 발놀림: 작은 십자날로 공격력의 100%만큼 물리 피해를 입힙니다. 적에게 적중하면 1.5초 동안 이동 속도가 12% 증가하며, 반복 적중은 중첩되지 않고 지속시간만 갱신합니다.",
        "skill": "Q—부메랑 검: 사거리 750의 관통 십자날을 던집니다. 나갈 때와 돌아올 때 각각 30 + 공격력의 55%만큼 물리 피해를 입히며, 같은 대상은 각 구간에서 한 번만 맞습니다. 재사용 대기시간 6초입니다.",
        "skill2": "E—주문 방패: 1.5초 동안 받는 스킬 피해를 100% 감소시키고, 시전 즉시 60 + 공격력의 15%만큼 회복하며 2초 동안 이동 속도가 20% 증가합니다. 재사용 대기시간 12초입니다. 데이터 버전은 시간제 피해 방어로 첫 주문에 소모되지 않고 군중 제어나 비피해 효과를 막지 못합니다.",
        "ult": "R—사냥 개시: 적 챔피언이 850 안에 있을 때 1000 안의 아군 챔피언 이동 속도를 5초 동안 25% 증가시킵니다. 재사용 대기시간 50초이며 피해를 주지 않고 시비르 자신에게는 한 번만 적용됩니다."
      },
      "cavalry_knight": {
        "name": "클레드",
        "attack": "미늘창 찌르기: 클레드가 미늘창을 휘둘러 공격력의 100%만큼 물리 피해를 입힙니다.",
        "skill": "Q—덫날리기: 지정 방향으로 관통하지 않는 덫을 발사합니다. 처음 적중한 적 챔피언에게 30 + 공격력의 80%만큼 물리 피해를 입히고 0.75초 동안 20% 둔화시킵니다. 0.75초 후 같은 대상에게 20 + 공격력의 40%만큼 추가 물리 피해를 입히고 클레드 쪽으로 끌어당겨 0.5초 속박합니다. 데이터 버전은 지연 끌어당기기 전에 줄 거리를 다시 확인하지 않습니다. 재사용 대기시간은 6초입니다.",
        "skill2": "E—이랴!: 지정 방향으로 돌진해 처음 적중한 적 챔피언에게 멈추며 30 + 공격력의 80%만큼 물리 피해를 입힙니다. 적중하면 클레드의 이동 속도가 1초 동안 20% 증가합니다. 데이터 버전은 한 번만 돌진하며 재사용할 수 없습니다. 재사용 대기시간은 8초입니다.",
        "ult": "R—돌겨어어억!!!: 최대 1200까지 돌진하며 이동 속도 50%, 200 + 공격력의 80%만큼 보호막, 짧은 군중 제어 면역을 얻습니다. 4초 동안 남는 직선 경로는 다른 아군의 이동 속도를 25% 높입니다. 처음 충돌한 적 챔피언에게 80 + 공격력의 100% + 최대 체력의 2%만큼 물리 피해를 입히고 밀쳐내며 공중에 띄웁니다. 경로는 휘지 않고 아군 이동 방향도 판정하지 않습니다."
      },
      "dancer": {
        "name": "자야",
        "attack": "관통상: 일반 깃털은 공격력의 100%만큼 물리 피해를 입힙니다. Q, E, R 사용 후 다음 3회의 기본 공격은 관통 깃털이 되어 대상에게 공격력의 65%, 직선상의 포탑이 아닌 적에게 공격력의 35%만큼 피해를 입힙니다. 강화 공격마다 깃털 1개를 남기며 최대 5개입니다.",
        "skill": "Q—깃털 연타: 지정 방향으로 관통 깃털 2개를 던지며 두 번째 깃털은 0.1초 뒤 발사됩니다. 각 깃털은 25 + 공격력의 45%만큼 물리 피해를 입히고 저장된 깃털을 2개 늘려 최대 5개로 만듭니다. 사용 후 관통상 3회를 준비합니다. 재사용 대기시간은 6초입니다.",
        "skill2": "E—깃부르미: 독립된 skill2로 보이지 않는 방향 기준점을 보내고 저장된 깃털 수를 같은 직선으로 회수합니다. 1개는 단일, 2개는 이중, 3개 이상은 깃털 무리로 표시되며 피해는 20 + 공격력의 25%에서 80 + 공격력의 65%까지 증가합니다. 3/4/5개 분기만 중심선을 0.75초 속박합니다. 깃털 수를 소모하고 관통상 3회를 준비합니다. 재사용 대기시간은 12초입니다.",
        "ult": "R—저항의 비상: 1초 동안 피해와 군중 제어 방호를 얻은 뒤 넓고 관통하는 깃털 부채를 전방으로 발사해 80 + 공격력의 70%만큼 물리 피해를 입힙니다. 저장 깃털을 5개로 만들고 관통상 3회를 준비하며, 깃털 회수나 E를 자동으로 발동하지 않습니다. 재사용 대기시간은 50초입니다. 방호 창은 LoL의 대상 지정 불가를 근사하며 자야는 전장에서 사라지지 않습니다."
      },
      "demon": {
        "name": "우르곳",
        "attack": "메아리치는 불꽃: 기본 공격으로 공격력의 100%만큼 물리 피해를 입힙니다. 우르곳마다 2초의 산탄포 다리 재사용 대기시간이 있으며, 준비되면 20 + 공격력의 30% + 대상 최대 체력의 2%만큼 추가 물리 피해를 입힙니다.",
        "skill": "W—심판의 원: 유효한 포탑이 아닌 적 하나에게 안정적인 압축 사격을 가해 즉시 96 + 공격력의 240%만큼 물리 피해를 입힙니다. 이후 4초 동안 이동 속도가 12% 감소하고 방어력 20과 마법 저항력 10을 얻습니다. 재사용 대기시간 10초입니다.",
        "skill2": "E—경멸: 3초 동안 160 + 공격력의 70%만큼 보호막을 얻고 대상 적 챔피언의 뒤로 돌진합니다. 70 + 공격력의 90%만큼 물리 피해와 1초 기절을 주고 대상을 자신의 뒤로 넘깁니다. 재사용 대기시간 7초입니다.",
        "ult": "R—불사의 공포: 최대 900 사거리의 비관통 드릴을 발사합니다. 처음 적중한 적 챔피언에게 80 + 공격력의 60%만큼 물리 피해를 주고 1.5초 동안 35% 둔화시킵니다. 0.75초 후 끌어당기며 현재 체력이 25% 이하라면 처형합니다. 실제 처형에 성공한 경우에만 주변 320의 적 챔피언에게 30 + 공격력의 30%만큼 물리 피해와 0.75초 공포를 줍니다. 재사용 대기시간 50초입니다."
      },
      "dual_blader": {
        "name": "요네",
        "attack": "사냥꾼의 길: 기본 공격은 강철검과 아자카나 검을 번갈아 사용하며 공격력의 100%만큼 물리 피해를 줍니다.",
        "skill": "Q—필멸의 검: 지정한 방향으로 25000만큼 돌진해 적에게 75+공격력 80%의 물리 피해를 주고 0.75초 띄웁니다. 적 한 명에게 적중할 때마다 공격력 5%만큼 회복합니다. 재사용 대기시간은 5초입니다.",
        "skill2": "W—영혼 가르기: 전방으로 35000 거리의 넓은 칼날 파동을 보내 80+공격력 80%의 물리 피해를 주고 밀쳐냅니다. 적 한 명에게 적중할 때마다 3초 동안 20+공격력 20%의 보호막을 얻습니다. 재사용 대기시간은 8초입니다.",
