{
  "en": {
    "description": {
      "lol_shen": {
        "name": "Shen",
        "attack": "Ninja Blade: Shen makes a steady melee strike for 100% Attack physical damage.",
        "skill": "Twilight Assault: Sends the spirit blade through enemies, dealing 40 + 60% Ability Power magic damage and slowing them by 25% for 1.5 seconds. Hitting an enemy grants Shen a 120 shield for 2 seconds.",
        "skill2": "Spirit's Refuge: Creates a defensive field around Shen. Allied champions in the field gain a 150 + 40% Ability Power shield for 2.5 seconds, while enemy champions lose 30% Attack Speed for 2 seconds.",
        "ult": "Stand United: Targets a distant allied champion and grants a 900 + 80% Ability Power shield for 3 seconds. After 0.8 seconds Shen teleports to the ally and taunts nearby enemy champions for 0.75 seconds. The data-champion AI chooses an ally; exact lowest-health targeting is not guaranteed."
      },
      "lol_lucian": {
        "name": "Lucian",
        "attack": "Relic Pistols: Fires a light bolt for 100% Attack physical damage. After casting Q, E, or R, Lightslinger empowers the next attack for 4 seconds: it fires normally, then fires a second shot 0.1 seconds later for 45% Attack physical damage.",
        "skill": "Piercing Light: Targets an enemy champion and, after 0.17 seconds, fires a penetrating 760-range line through them. All non-tower enemies in the line take 55 + 85% Attack physical damage. Activates Lightslinger.",
        "skill2": "Relentless Pursuit: Dashes 300 range in the chosen direction without dealing damage. Activates Lightslinger.",
        "ult": "The Culling: Stands still and fires 15 shots in the chosen direction, beginning after 0.2 seconds and repeating every 0.13 seconds. Each non-piercing shot deals 8 + 18% Attack physical damage to the first non-tower enemy hit. The channel can be interrupted. Activates Lightslinger when it finishes."
      }
    }
  },
  "zh-hans": {
    "description": {
      "lol_shen": {
        "name": "慎",
        "attack": "忍刃：慎进行稳定的近战攻击，造成100%攻击力的物理伤害。",
        "skill": "暮光斩：灵刃穿过敌人，造成40 + 60%法术强度的魔法伤害，并使其减速25%，持续1.5秒。命中敌人后，慎获得120点护盾，持续2秒。",
        "skill2": "灵佑领域：慎在身边展开防御领域。范围内友方英雄获得150 + 40%法术强度的护盾，持续2.5秒；敌方英雄的攻击速度降低30%，持续2秒。",
        "ult": "秘奥义！慈悲度魂落：选择一名远处友方英雄，给予900 + 80%法术强度的护盾，持续3秒。0.8秒后慎传送至其身边，并嘲讽附近敌方英雄0.75秒。数据英雄AI会选择一名友军，但不保证始终锁定最低生命值目标。"
      },
      "lol_lucian": {
        "name": "卢锡安",
        "attack": "遗迹圣枪：发射圣光弹，造成100%攻击力的物理伤害。施放Q、E或R后，圣光银弹强化4秒内的下一次普攻：首发正常命中，0.1秒后追加一发造成45%攻击力物理伤害的子弹。",
        "skill": "透体圣光：锁定一名敌方英雄，0.17秒后向其方向发射一道760距离的贯穿光束，对沿线所有非防御塔敌人造成55 + 85%攻击力的物理伤害。激活圣光银弹。",
        "skill2": "冷酷追击：向指定方向冲刺300距离，不造成伤害。激活圣光银弹。",
        "ult": "圣枪洗礼：原地朝指定方向连续发射15发子弹，0.2秒后发射首发，之后每0.13秒一发。每发子弹不可穿透，对首个命中的非防御塔敌人造成8 + 18%攻击力的物理伤害。引导可被打断，结束后激活圣光银弹。"
      }
    }
  },
  "zh-hant": {
    "description": {
      "lol_shen": {
        "name": "慎",
        "attack": "忍刃：慎進行穩定的近戰攻擊，造成100%攻擊力的物理傷害。",
        "skill": "暮光斬：靈刃穿過敵人，造成40 + 60%法術強度的魔法傷害，並使其減速25%，持續1.5秒。命中敵人後，慎獲得120點護盾，持續2秒。",
        "skill2": "靈佑領域：慎在身邊展開防禦領域。範圍內友方英雄獲得150 + 40%法術強度的護盾，持續2.5秒；敵方英雄的攻擊速度降低30%，持續2秒。",
        "ult": "秘奧義！慈悲度魂落：選擇一名遠處友方英雄，給予900 + 80%法術強度的護盾，持續3秒。0.8秒後慎傳送至其身邊，並嘲諷附近敵方英雄0.75秒。資料英雄AI會選擇一名友軍，但不保證始終鎖定最低生命值目標。"
      },
      "lol_lucian": {
        "name": "路西恩",
        "attack": "遺跡聖槍：發射聖光彈，造成100%攻擊力的物理傷害。施放Q、E或R後，聖光銀彈強化4秒內的下一次普攻：首發正常命中，0.1秒後追加一發造成45%攻擊力物理傷害的子彈。",
        "skill": "透體聖光：鎖定一名敵方英雄，0.17秒後向其方向發射一道760距離的貫穿光束，對沿線所有非防禦塔敵人造成55 + 85%攻擊力的物理傷害。啟動聖光銀彈。",
        "skill2": "冷酷追擊：向指定方向衝刺300距離，不造成傷害。啟動聖光銀彈。",
        "ult": "聖槍洗禮：原地朝指定方向連續發射15發子彈，0.2秒後發射首發，之後每0.13秒一發。每發子彈不可穿透，對首個命中的非防禦塔敵人造成8 + 18%攻擊力的物理傷害。引導可被打斷，結束後啟動聖光銀彈。"
      }
    }
  }
}
