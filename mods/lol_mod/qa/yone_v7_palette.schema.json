{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamfight-manager2.local/lol_mod/yone_v7_palette.schema.json",
  "title": "Yone V7 fixed RGBA role palette",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route", "weapon_roles", "colors"],
  "properties": {
    "schema_version": {"const": 7},
    "route": {"const": "dual-sword-v7"},
    "weapon_roles": {
      "const": {
        "steel": {
          "dark": ["source_06", "source_07"],
          "mid": ["source_04"],
          "highlight": ["source_03"]
        },
        "azakana": {
          "dark": ["mask_03", "mask_04"],
          "red": ["mask_00", "mask_02"],
          "highlight": ["mask_01"]
        }
      }
    },
    "colors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 49,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "rgba"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "rgba": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 0, "maximum": 255},
              {"type": "integer", "minimum": 0, "maximum": 255},
              {"type": "integer", "minimum": 0, "maximum": 255},
              {"enum": [0, 255]}
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
