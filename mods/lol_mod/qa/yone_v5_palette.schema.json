{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamfight-manager2.local/lol_mod/yone_v5_palette.schema.json",
  "title": "Yone V5 fixed RGBA role palette",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route", "colors"],
  "properties": {
    "schema_version": {"const": 5},
    "route": {"const": "exact-native-v5"},
    "colors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 33,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "rgba"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "rgba": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 0, "maximum": 255},
              {"type": "integer", "minimum": 0, "maximum": 255},
              {"type": "integer", "minimum": 0, "maximum": 255},
              {"enum": [0, 255]}
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
