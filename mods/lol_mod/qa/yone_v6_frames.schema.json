{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamfight-manager2.local/lol_mod/yone_v6_frames.schema.json",
  "title": "Yone V6 exact-native actor frame contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "atlas_size",
    "palette_file",
    "body_preview",
    "frames"
  ],
  "properties": {
    "schema_version": {"const": 6},
    "route": {"const": "exact-native-v6"},
    "atlas_size": {"const": [3502, 88]},
    "palette_file": {"$ref": "#/$defs/safePngOrJsonPath"},
    "body_preview": {"$ref": "#/$defs/safePngOrJsonPath"},
    "frames": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {"$ref": "#/$defs/frame"}
    }
  },
  "$defs": {
    "safePngOrJsonPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "index",
        "file",
        "rect",
        "bottom_margin",
        "face_bbox",
        "eye_pixels",
        "mask_bbox",
        "foot_zones",
        "face_visibility"
      ],
      "properties": {
        "action": {
          "enum": [
            "skill2",
            "hit",
            "attack",
            "skill2_dash",
            "ult",
            "run",
            "skill2_attack",
            "idle",
            "dead",
            "skill"
          ]
        },
        "index": {"type": "integer", "minimum": 0},
        "file": {
          "allOf": [
            {"$ref": "#/$defs/safePngOrJsonPath"},
            {"pattern": "\\.png$"}
          ]
        },
        "rect": {"$ref": "#/$defs/rect"},
        "bottom_margin": {"type": "integer", "minimum": 0},
        "face_bbox": {
          "oneOf": [
            {"$ref": "#/$defs/rect"},
            {"type": "null"}
          ]
        },
        "eye_pixels": {
          "type": "array",
          "items": {"$ref": "#/$defs/point"},
          "uniqueItems": true
        },
        "mask_bbox": {
          "oneOf": [
            {"$ref": "#/$defs/rect"},
            {"type": "null"}
          ]
        },
        "foot_zones": {
          "type": "array",
          "items": {"$ref": "#/$defs/rect"}
        },
        "face_visibility": {
          "enum": ["front", "profile", "hidden"]
        }
      }
    }
  }
}
