    }
  }

  #coach_delegation_indicator:color {
    color: #0000009a;

    width: 100%;
    height: 100%;

    visible: false;

    #text:label {
      @"asset/base/style/main#bold_label";

      width: 100%;
      height: 60px;

      anchor_y: 0.5;
      pivot_y: 1;
      y: -20px;

      size: 48;
      align_x: Center;
      align_y: Center;

      text: "#asset/base/text/ui?banpick.coach_delegation_running";
    }

    #cancel:color_icon_button {
      @"asset/base/style/main#secondary_button";

      width: 320px;
      height: 40px;

      anchor_x: 0.5;
      pivot_x: 0.5;

      anchor_y: 0.5;
      pivot_y: 0;
      y: 30px;

      text: {
        font: "asset/base/font/set/bold";
        text: "#asset/base/text/ui?common.cancel";
        align_x: Center;
        align_y: Center;
        size: 24;
      }
    }
  }

  #fade:color {
    width: 100%;
    height: 100%;

    color: #000000ff;

    visible: false;
  }

  #tooltip:color {
    ignore_event: true;
    width: 100px;
    height: 29px;
    visible: false;

    back_color: #161721ff;
    color: #4a4c56ff;
    stroke: 1;

    rounding: Uniform {
      rounding: 8;
    }

    #text:label {
      @"asset/base/style/main#label";

      anchor_x: 0.5;
      pivot_x: 0.5;

      width: 100px;
      height: 24px;
      y: 3px;

      size: 16;

      align_x: Center;
      align_y: Center;

      text: "";
    }

    #pos_header:label {
      @"asset/base/style/main#label";
      width: 100%;
      height: 20px;
      x: 8px;
      y: 29px;
      size: 12;
      color: #8a8c96ff;
      align_y: Center;
      visible: false;
    }

    #pos_row1:empty {
      width: 100%;
      height: 22px;
      y: 49px;
      visible: false;

      #icon:image {
        width: 18px;
        height: 18px;
        source: "asset/base/ui/icons/mid";
        x: 8px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        ignore_event: true;
      }

      #text:label {
        @"asset/base/style/main#label";
        width: 80px;
        height: 100%;
        x: 30px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        size: 14;
        align_y: Center;
      }
    }

    #pos_row2:empty {
      width: 100%;
      height: 22px;
      y: 71px;
      visible: false;

      #icon:image {
        width: 18px;
        height: 18px;
        source: "asset/base/ui/icons/mid";
        x: 8px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        ignore_event: true;
      }

      #text:label {
        @"asset/base/style/main#label";
        width: 80px;
        height: 100%;
        x: 30px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        size: 14;
        align_y: Center;
      }
    }
  }

}
