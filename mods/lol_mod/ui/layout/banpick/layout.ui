main:match_ui {
  width: 100%;
  height: 100%;

  #background:color {
    width: 100%;
    height: 100%;

    color: #07080bff;
  }

  #lol_bp_background:image {
    ignore_event: true;
    width: 100%;
    height: 100%;
    source: "asset/lol_mod/ui/banpick/lol_bp_background";
  }

  #header:color {
    color: #161721ff;
    width: 100%;
    height: 50px;

    #lol_bp_header_chrome:image {
      ignore_event: true;
      width: 100%;
      height: 100%;
      source: "asset/lol_mod/ui/banpick/lol_bp_header_chrome";
    }

    #step:label {
      @"asset/base/style/main#label";
      width: 214px;
      height: 100%;
      x:310px;

      align_y: Center;

      text: "test";
      size: 18;
    }

    #delegate_btn:color_icon_button {
      @"asset/base/style/main#secondary_button";
      x: 10px;
      y: 5px;
      width: 290px;
      height: 40px;

      text: {
        font: "asset/base/font/set/bold";
        text: "#asset/base/text/ui?banpick.delegate_to_coach";
        align_x: Center;
        align_y: Center;
        size: 14;
      }
    }

    #desc:label {
      @"asset/base/style/main#label";
      width: 1084px;
      height: 100%;

      align_x: Center;
      align_y: Center;

      anchor_x: 0.5;
      pivot_x: 0.5;

      anchor_y: 0.5;
      pivot_y: 0.5;

      text: "test";
      size: 26;

      #blue_arrow:image {
        anchor_x: 0;
        pivot_x: 1;
        x: 187px;

        anchor_y: 0.5;
        pivot_y: 0.5;

        width: 40px;
        height: 40px;

        source: "asset/base/ui/icons/left_arrow";
        color: #5b73ffff;
      }

      #red_arrow:image {
        anchor_x: 1;
        pivot_x: 0;
        x: -187px;

        anchor_y: 0.5;
        pivot_y: 0.5;

        width: 40px;
        height: 40px;

        source: "asset/base/ui/icons/right_arrow";
        color: #ef6471ff;
      }
    }

    #swap_phase:label {
      @"asset/base/style/main#label";
      size: 18;

      pivot_x: 1;
      anchor_x: 1;
      x: -43px;

      anchor_y: 0.5;
      pivot_y: 0.5;

      width: 506px;
      height: 50px;

      align_x: Right;
      align_y: Center;

      text: "#asset/base/text/ui?banpick.swap_phase";
    }

    #phase:color {
      width: 100%;
      height: 2px;

      anchor_y: 1;
      pivot_y: 1;
    }
  }

  #bottom:color {
    color: #161721ff;

    width: 100%;
    height: 100px;

    anchor_y: 1;
    pivot_y: 1;

    #lol_bp_bottom_chrome:image {
      ignore_event: true;
      width: 100%;
      height: 100%;
      source: "asset/lol_mod/ui/banpick/lol_bp_bottom_chrome";
    }

    #matchup:label {
      @"asset/base/style/main#label";
      height: 30px;
      width: 268px;

      anchor_x: 0.5;
      pivot_x: 0.5;

      x: 0px;
      y: 5px;

      align_x: Center;
      align_y: Center;
      color: #e8e8e8ff;
      size: 16;
      text: "A vs B";
    }

    #blue_side:empty {
      width: 50%;
      height: 100%;

      #icon_slot:color {
        anchor_x: 1;
        pivot_x: 1;

        x: -20px;
        y: 40px;

        width: 52px;
        height: 52px;

        color: #1d1f2cff;

        #icon:image {
          width: 46px;
          height: 46px;

          anchor_x: 0.5;
          pivot_x: 0.5;
          anchor_y: 0.5;
          pivot_y: 0.5;

          source: "asset/base/aseprite_resources/team_logo";
        }
      }

      #name:label {
        @"asset/base/style/main#bold_label";
        x: 500px;
        y: 5px;

        width: 316px;
        height: 30px;

        size: 24;

        align_x: Center;
      }

      #bans:empty {
        x: 515px;
        y: 40px;

        width: 286px;
        height: 54px;

        child_type: LeftToRight {
          spacing: 4px;
        }
      }

      #sets:empty {
        x: 878px;
        y: 60px;
        width: 52px;

        child_type: LeftToRight {
          spacing: 2px;
        }
      }
    }

    #red_side:empty {
      width: 50%;
      height: 100%;
      anchor_x: 1;
      pivot_x: 1;

      #icon_slot:color {
        color: #1d1f2cff;
        x: 20px;
        y: 40px;

        width: 52px;
        height: 52px;

        #icon:image {
          width: 46px;
          height: 46px;

          anchor_x: 0.5;
          pivot_x: 0.5;
          anchor_y: 0.5;
          pivot_y: 0.5;

          source: "asset/base/aseprite_resources/team_logo";
        }
      }

      #name:label {
        @"asset/base/style/main#bold_label";

        anchor_x: 1;
        pivot_x: 1;

        x: -500px;
        y: 5px;

        width: 316px;
        height: 30px;

        size: 24;

        align_x: Center;
      }

      #bans:empty {
        x: -515px;
        y: 40px;

        anchor_x: 1;
        pivot_x: 1;

        width: 286px;
        height: 54px;

        child_type: LeftToRight {
          spacing: 4px;
        }
      }

      #sets:empty {
        anchor_x: 1;
        pivot_x: 1;

        x: -878px;
        y: 60px;
        width: 52px;

        child_type: LeftToRight {
          spacing: 2px;
        }
      }

      #tools_panel:color {
        anchor_x: 1;
        pivot_x: 1;

        x: -348px;
        y: 0px;

        width: 60px;
        height: 36px;

        visible: false;

        color: #1d1f2cff;

        rounding: Uniform {
          rounding: 8;
        }

        child_type: LeftToRight {
          spacing: 4px;
        }

        padding: {
          left: 4px;
          top: 6px;
          right: 4px;
          bottom: 6px;
        }

        #chat_btn:button {
          width: 24px;
          height: 24px;

          source: "asset/base/ui/icons/chat";
          color: #a5a5abff;

          hover: {
            color: #e8e8e8ff;
          }

          active: {
            color: #e8e8e8ff;
          }

          #chat_red_dot:color {
            width: 14px;
            height: 14px;

            anchor_x: 1;
            pivot_x: 0.5;
            x: -3px;

            anchor_y: 0;
            pivot_y: 0.5;
            y: 3px;

            ignore_event: true;
            visible: false;

            color: #eb3d4dff;

            rounding: Uniform {
              rounding: 7;
            }
          }
        }

        #chart_btn:button {
          width: 24px;
          height: 24px;

          source: "asset/base/ui/icons/chart";
          color: #a5a5abff;

          hover: {
            color: #e8e8e8ff;
          }

          active: {
            color: #e8e8e8ff;
          }
        }
      }

    }

    #vs:image {
      source: "asset/base/ui/icons/battle";
      width: 20px;
      height: 20px;

      pivot_x: 0.5;
      anchor_x: 0.5;

      y: 43px;
    }

    #need_win:label {
      @"asset/base/style/main#label";
      height: 20px;
      width: 62px;

      anchor_x: 0.5;
      pivot_x: 0.5;

      x: 0px;
      y: 69px;

      align_x: Center;
      align_y: Center;
      color: #e8e8e8ff;
      size: 16;
      text: "Bo3";
    }
  }

  #blue_picks:empty {
    y: 60px;

    width: 300px;
    height: 910px;

    child_type: TopToBottom {
      spacing: 10px;
    }
  }

  #blue_pool:color {
    width: 300px;
    height: 58px;

    color: #1d1f2cff;

    anchor_y: 1;
    pivot_y: 1;
    y: -21px;

    visible: false;

    rounding: Individual {
      top_left: 0;
      top_right: 12;
      bottom_left: 0;
      bottom_right: 12;
    }

    #data:empty {
      width: 280px;
      height: 48px;

      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      child_type: LeftToRight {
        spacing: 10px;
      }
    }
  }

  #red_picks:empty {
    anchor_x: 1;
    pivot_x: 1;
    y: 60px;

    width: 300px;
    height: 910px;

    child_type: TopToBottom {
      spacing: 10px;
    }
  }

  #red_pool:color {
    width: 300px;
