  #coach_dialogue_toast:color {
    ignore_event: true;
    width: 520px;
    height: 118px;
    visible: false;

    back_color: #161721ff;
    color: #4a4c56ff;
    stroke: 1;

    rounding: Uniform {
      rounding: 8;
    }

    #face_slot:color {
      x: 12px;
      y: 40px;
      width: 38px;
      height: 38px;

      color: #1d1f2cff;

      rounding: Uniform {
        rounding: 6;
      }

      #face:canvas {
        width: 38px;
        height: 38px;
      }

      #face_fade:color {
        ignore_event: true;
        width: 38px;
        height: 38px;

        color: #16172100;

        rounding: Uniform {
          rounding: 6;
        }
      }
    }

