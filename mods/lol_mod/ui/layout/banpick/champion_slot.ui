champion_slot:banpick_champion_slot {
  width: 132.4444px;
  height: 130px;

  base: {
    back_color: #161721ff;
    down_color: #0f1016ff;
    text_color: #e8e8e8ff;
  }

  blue_picked: {
    back_color: #0d1440ff;
    down_color: #05081aff;
    text_color: #adb9ffff;
  }

  red_picked: {
    back_color: #3b0f13ff;
    down_color: #180608ff;
    text_color: #f7b1b8ff;
  }

  banned: {
    back_color: #666666ff;
    down_color: #333333ff;
    text_color: #666666ff;
  }

  line_width: 1;
  rounding: 12;
  down_height: 38;

  line_color: {
    normal: #4a4c56ff;
    hover: #e8e8e8ff;
  }

  hover_sound: "asset/base/sound/sfx/UI_mouse_hover";
  click_sound: "asset/base/sound/sfx/UI_mouse_click";

  #lol_bp_champion_card_frame:image {
    ignore_event: true;
    width: 100%;
    height: 100%;
    source: "asset/lol_mod/ui/banpick/lol_bp_champion_card_frame";
  }

  #icon:canvas {
    width: 131.4444px;
    height: 88px;

    anchor_x: 0.5;
    pivot_x: 0.5;

    ignore_event: true;
  }

  #name:label {
    @"asset/base/style/main#label";
    width: 131.4444px;
    height: 37px;
    ignore_event: true;

    anchor_y: 1;
    pivot_y: 1;

    align_x: Center;
    align_y: Center;

    size: 14;
  }

  #ban:image {
    width: 18px;
    height: 18px;

    source: "asset/base/ui/icons/ban";

    x: -6px;
    y: 6px;

    anchor_x: 1;
    pivot_x: 1;

    visible: false;
    ignore_event: true;
  }

  #blue:color {
    visible: false;
    ignore_event: true;

    x: -4px;
    y: 4px;

    anchor_x: 1;
    pivot_x: 1;

    width: 26px;
    height: 26px;

    color: #263cbfff;
    rounding: Uniform {
      rounding: 8;
    }

    #text:label {
      @"asset/base/style/main#label";
      width: 100%;
      height: 100%;
      size: 14;

      align_x: Center;
      align_y: Center;
    }
  }

  #red:color {
    visible: false;
    ignore_event: true;

    x: -4px;
    y: 4px;

    anchor_x: 1;
    pivot_x: 1;

    width: 26px;
    height: 26px;

    color: #b02e3aff;
    rounding: Uniform {
      rounding: 8;
    }

    #text:label {
      @"asset/base/style/main#label";
      width: 100%;
      height: 100%;
      size: 14;

      align_x: Center;
      align_y: Center;
    }
  }

  #fearless_icon:color {
    visible: false;
    ignore_event: true;

    x: -4px;
    y: 4px;

    anchor_x: 1;
    pivot_x: 1;

    width: 22px;
    height: 22px;

    back_color: #00000000;
    stroke: 1;

    rounding: Uniform {
      rounding: 11;
    }

    #text:label {
      @"asset/base/style/main#label";
      width: 100%;
      height: 100%;
      size: 14;

      align_x: Center;
      align_y: Center;
    }
  }

  #fearless_x:image {
    visible: false;
    ignore_event: true;

    width: 12px;
    height: 12px;

    source: "asset/base/ui/icons/cross";

    x: -6px;
    y: 6px;

    anchor_x: 1;
    pivot_x: 1;
  }

  #fearless_tooltip:color {
    anchor_x: 0.5;
    pivot_x: 0.5;
    anchor_y: 1;
    pivot_y: 0;
    y: 6px;
    height: 34px;
    width: 350px;
    visible: false;
    ignore_event: true;

    back_color: #161721ff;
    color: #4a4c56ff;

    stroke: 1;
    z: 101;

    rounding: Uniform {
      rounding: 8;
    }

    #text:label {
      @"asset/base/style/main#label";
      width: 100%;
      height: 100%;
      x: 8px;
      z: 101;
      anchor_y: 0.5;
      pivot_y: 0.5;

      size: 14;

      align_y: Center;
    }
  }

  #tier:label {
    @"asset/base/style/main#label";
    width: 30px;
    height: 18px;
    x: 6px;
    y: 68px;
    size: 16;

    align_x: Left;
    align_y: Center;

    visible: false;
    ignore_event: true;
  }

  #pos1:image {
    width: 18px;
    height: 18px;
    source: "asset/base/ui/icons/mid";
    x: 90.4444px;
    y: 66px;
    ignore_event: true;
    visible: false;
  }

  #pos2:image {
    width: 18px;
    height: 18px;
    source: "asset/base/ui/icons/mid";
    x: 111.4444px;
    y: 66px;
    ignore_event: true;
    visible: false;
  }

  #pos_tooltip:color {
    anchor_x: 0.5;
    pivot_x: 0.5;
    anchor_y: 1;
    pivot_y: 0;
    y: 6px;
    visible: false;
    ignore_event: true;
    z: 101;

    back_color: #161721ff;
    color: #4a4c56ff;
    stroke: 1;

    rounding: Uniform {
      rounding: 8;
    }

    #header:label {
      @"asset/base/style/main#label";
      width: 100%;
      height: 20px;
      x: 8px;
      y: 4px;
      z: 101;
      size: 12;
      color: #8a8c96ff;
      align_y: Center;
    }

    #row1:empty {
      width: 100%;
      height: 22px;
      y: 24px;

      #icon:image {
        width: 18px;
        height: 18px;
        source: "asset/base/ui/icons/mid";
        x: 8px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        z: 101;
        ignore_event: true;
      }

      #text:label {
        @"asset/base/style/main#label";
        width: 80px;
        height: 100%;
        x: 30px;
        z: 101;
        anchor_y: 0.5;
        pivot_y: 0.5;
        size: 14;
        align_y: Center;
      }
    }

    #row2:empty {
      width: 100%;
      height: 22px;
      y: 46px;
      visible: false;

      #icon:image {
        width: 18px;
        height: 18px;
        source: "asset/base/ui/icons/mid";
        x: 8px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        z: 101;
        ignore_event: true;
      }

      #text:label {
        @"asset/base/style/main#label";
        width: 80px;
        height: 100%;
        x: 30px;
        z: 101;
        anchor_y: 0.5;
        pivot_y: 0.5;
        size: 14;
        align_y: Center;
      }
    }
  }

}
