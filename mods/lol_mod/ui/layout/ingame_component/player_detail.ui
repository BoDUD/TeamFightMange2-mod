player_detail:empty {
  width: 887px;
  height: 40px;

  #position:image {
    x: 5px;
    y: 5px;

    width: 30px;
    height: 30px;

    source: "asset/base/ui/icons/mid";
  }

  #blue_player:empty {
    width: 392.5px;
    height: 40px;
    x: 71px;

    #lol_hud_player_detail_blue:image {
      ignore_event: true;
      width: 100%;
      height: 100%;
      source: "asset/lol_mod/ui/ingame/lol_hud_player_detail_blue";
    }

    #champion:color {
      width: 40px;
      height: 40px;


      color: #263cbfff;

      #icon:image {
        width: 40px;
        height: 40px;

        anchor_x: 0.5;
        anchor_y: 0.5;
        pivot_x: 0.5;
        pivot_y: 0.5;
      }
    }

    #name:label {
      @"asset/base/style/main#bold_label";
      x: 60px;
      y: 6px;

      width: 109.5px;
      height: 28px;

      size: 18;
      text: "Name";

      align_y: Center;
    }

    #value:label {
      @"asset/base/style/main#bold_label";
      x: 109.5px;
      y: 6px;

      width: 126px;
      height: 28px;

      size: 18;
      text: "99,999";
      align_x: Right;
      align_y: Center;
    }

    #graph:color {
      color: #4a4c56ff;
      back_color: #00000000;
      stroke: 1;

      width: 137px;
      height: 40px;

      anchor_x: 1;
      pivot_x: 1;

      rounding: Uniform {
        rounding: 8;
      }

      #data:canvas {
        anchor_x: 0.5;
        pivot_x: 0.5;
        anchor_y: 0.5;
        pivot_y: 0.5;

        width: 127px;
        height: 30px;
      }
    }
  }

  #red_player:empty {
    width: 392.5px;
    height: 40px;

    x: 493.5px;

    #lol_hud_player_detail_red:image {
      ignore_event: true;
      width: 100%;
      height: 100%;
      source: "asset/lol_mod/ui/ingame/lol_hud_player_detail_red";
    }

    #champion:color {
      width: 40px;
      height: 40px;

      color: #b02e3aff;

      #icon:image {
        width: 40px;
        height: 40px;

        anchor_x: 0.5;
        anchor_y: 0.5;
        pivot_x: 0.5;
        pivot_y: 0.5;
      }
    }


    #name:label {
      @"asset/base/style/main#bold_label";
      x: 60px;
      y: 6px;

      width: 109.5px;
      height: 28px;

      size: 18;
      text: "Name";

      align_y: Center;
    }

    #value:label {
      @"asset/base/style/main#bold_label";
      x: 109.5px;
      y: 6px;

      width: 126px;
      height: 28px;

      size: 18;
      text: "99,999";
      align_x: Right;
      align_y: Center;
    }

    #graph:color {
      color: #4a4c56ff;
      back_color: #00000000;
      stroke: 1;

      width: 137px;
      height: 40px;

      anchor_x: 1;
      pivot_x: 1;

      rounding: Uniform {
        rounding: 8;
      }

      #data:canvas {
        anchor_x: 0.5;
        pivot_x: 0.5;
        anchor_y: 0.5;
        pivot_y: 0.5;

        width: 127px;
        height: 30px;
      }
    }
  }
}
