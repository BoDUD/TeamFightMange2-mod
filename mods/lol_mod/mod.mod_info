  "version": "0.11.1",
  "description": "Local Shen, Urgot, and Yone joint review bundle for Teamfight Manager 2 v0.5.1. It keeps Shen's visible spirit-blade Q and native 1.5-second E taunt, Urgot's crash-safe W and flip E, and Yone's guarded Q3 plus E-only Soul Unbound. The game runtime updated to base 0.5.1 while its bundled SDK remains base 0.5.0, so legacy client/server extensions that directly touch internal GameUI, RenderState, ClientDatabase, and ServerModContext layouts are disabled by default. Combat-native Mod API 0.8 hooks remain enabled; dynamic BP splash, portrait-command, and deterministic-dragon rewrites stay off until a matching 0.5.1 SDK is available. Yone E uses fast CC-immune pathing because Mod API 0.8 cannot directly write hero coordinates.",
  "last_updated": "2026-07-15",
  "dependencies": [
    {
      "mod_id": "base",
      "version": ">=0.5.0"
    }
  ]
}
