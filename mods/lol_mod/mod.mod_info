{
  "id": "lol_mod",
  "mod_id": "lol_mod",
  "name": "League Champions & Rift Quality Pack / \u82f1\u96c4\u4e0e\u5ce1\u8c37\u54c1\u8d28\u5347\u7ea7",
  "author": "BoDUD",
  "version": "0.10.20",
  "description": "Adds Shen and reworks official champions 002-007 and 009 as Lucian, Orianna, Briar, Sivir, Kled, Xayah and Yone. Version 0.10.20 is built with the official Teamfight Manager 2 base 0.5.1 SDK. Yone now uses the unique asset/lol_mod/aseprite_resources/champions/yone_v7 actor key; byte-identical yone sheet and anim aliases remain only so saved 0.10.5 through 0.10.19 champion definitions cannot lose their embedded sprite resource. Steel and Azakana attacks, Q1/Q2, Q3 and W select their dedicated CasterAnimation at tick 0, while attack hit/toggle stays at tick 13 and Q projectile/rush/buff plus W cone/shield settlement stay at tick 8. Cast SFX and caster-follow visuals begin with the body action; target hit feedback remains in the delayed payload. The 4262x88, 18-tag, 67-frame V7 atlas preserves the official 3502x88, 13-tag, 54-frame Dual Blader prefix and the strict dual-sword palette and hand-to-tip geometry contract introduced in 0.10.19. BP grid, player assignment, management card, compact portrait and scoreboard are regenerated from a new source-direct V7 UI character with a readable face, separate legs and boots, and complete steel and Azakana swords while retaining the 0.10.17 geometry, top-88 sampling and -9 assignment baseline contracts. Game Sprite telemetry records the real texture key, loaded atlas size, UV/source rectangle and inferred V7 frame candidates; RenderCommand does not expose a true game tick or unique W tag, so the telemetry labels those limits honestly. Spirit Cleave remains the stateless 80-degree, 42000-range W from 0.10.5, dealing 35 + 45% Attack + 6% target maximum-health physical damage and settling one shield tier for zero through five champions hit. Retired E and 0.10.4 rectangular-W native names remain no-op saved-data compatibility only. A fresh 0.10.20 save is required to embed the new tick-0 behavior tree; older saves can still load through the byte-identical actor alias but cannot prove the new action timing. Version 0.10.19 is retained as partial history because it validated static V7 pixels but reused the old actor key, retained UI V6 and started custom attack/Q/W body states at the effect tick. The currently installed game has reported base 0.5.2, so live compatibility with that newer base still requires user verification and is not implied by the 0.5.1 SDK build. The broader legacy MatchUIRunner, ClientDatabase, dragon, server and other-champion rewrites remain explicitly opt-in; automated checks do not constitute live visual acceptance.",
  "last_updated": "2026-07-22",
  "dependencies": [
    {
      "mod_id": "base",
      "version": ">=0.5.1"
    }
  ]
}
